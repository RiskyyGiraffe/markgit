{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markgit.com/schemas/skill/v1.json",
  "title": "Markgit Source-Hosted Agent Skill Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "name", "slug", "description", "source", "compatibility"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": "1" },
    "kind": { "const": "skill" },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 255 },
    "logoUrl": { "type": "string", "format": "uri" },
    "description": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "maxLength": 100 },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "description": { "type": "string" },
        "websiteUrl": { "type": "string", "format": "uri" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryUrl", "url", "path", "revision"],
      "properties": {
        "publisher": { "type": "string", "minLength": 1, "maxLength": 255 },
        "repositoryUrl": { "type": "string", "format": "uri" },
        "url": { "type": "string", "format": "uri" },
        "path": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1, "maxLength": 255 },
        "licenseUrl": { "type": "string", "format": "uri" }
      }
    },
    "compatibility": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["agent-skills", "codex", "claude-code"] }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "codex": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "claudeCode": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "universal": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "contents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scripts": { "type": "boolean" },
        "references": { "type": "boolean" },
        "assets": { "type": "boolean" }
      }
    }
  }
}
