{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markgit.dev/schemas/tool/v1.json",
  "title": "Markgit Hosted Tool Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "slug", "description", "endpoint", "inputSchema", "pricing"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": "1" },
    "kind": { "const": "tool" },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 255 },
    "logoUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "description": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "maxLength": 100 },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "description": { "type": "string" },
        "websiteUrl": { "type": "string", "format": "uri" }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "method"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "method": { "enum": ["GET", "POST"] }
      }
    },
    "inputSchema": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "const": "object" } }
    },
    "outputSchema": { "type": "object" },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readOnly": { "type": "boolean" },
        "destructive": { "type": "boolean" },
        "idempotent": { "type": "boolean" },
        "openWorld": { "type": "boolean" },
        "readsPrivateData": { "type": "boolean" },
        "seesUntrustedContent": { "type": "boolean" },
        "writesExternalData": { "type": "boolean" },
        "sendsMessages": { "type": "boolean" },
        "spendsMoney": { "type": "boolean" },
        "executesCode": { "type": "boolean" },
        "requiresUserCredential": { "type": "boolean" },
        "allowedOutboundDomains": {
          "type": "array",
          "items": { "type": "string", "format": "hostname" },
          "uniqueItems": true
        },
        "dataRetention": { "enum": ["none", "transient", "stored", "unknown"] }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amountPerCallUsd"],
      "properties": {
        "amountPerCallUsd": { "type": "string", "pattern": "^\\d+(?:\\.\\d{1,4})?$" }
      }
    }
  }
}
