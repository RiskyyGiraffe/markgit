[Unit]
Description=Markgit secured custom-loop demo provider
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/projects/markgit/examples/custom-loop-provider
EnvironmentFile=/etc/markgit/demo-provider.env
ExecStart=/home/ubuntu/projects/markgit/examples/custom-loop-provider/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8011 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/projects/markgit/examples/custom-loop-provider

[Install]
WantedBy=multi-user.target
