DATABASE_URL=postgresql://postgres.PROJECT_REF:password@REGION.pooler.supabase.com:6543/postgres
PORT=3000
PUBLIC_WEB_URL=http://localhost:3001

# AI-assisted documentation imports and semantic search
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Optional: ngrok tunnel URL (for Stripe webhooks in dev)
NGROK_URL=https://your-tunnel.ngrok-free.dev

# Local development escape hatches. These are always disabled in production.
ALLOW_DIRECT_WALLET_FUNDING=false
MARKGIT_ALLOW_PRIVATE_OUTBOUND=false
MARKGIT_ALLOW_INSECURE_HTTP=false

# Comma-separated mkgt_users IDs allowed to quarantine or restore listings.
MARKGIT_ADMIN_USER_IDS=
