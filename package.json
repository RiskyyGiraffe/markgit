{
  "name": "markgit",
  "private": true,
  "packageManager": "pnpm@9.13.1",
  "scripts": {
    "dev": "pnpm --filter @markgit/api dev",
    "dev:web": "pnpm --filter @markgit/web dev",
    "dev:cli": "pnpm --filter @markgit/cli build --watch",
    "dev:all": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "build:api": "pnpm --filter @markgit/api build",
    "build:web": "pnpm --filter @markgit/web build",
    "db:generate": "pnpm --filter @markgit/api db:generate",
    "db:migrate": "pnpm --filter @markgit/api db:migrate",
    "db:seed": "pnpm --filter @markgit/api db:seed",
    "onboard:public-apis": "node scripts/onboard-public-apis.mjs",
    "onboard:official-skills": "pnpm --filter @markgit/api db:seed:official-skills",
    "onboard:official-mcps": "pnpm --filter @markgit/api db:seed:official-mcps",
    "refresh:catalog": "pnpm onboard:official-skills && pnpm onboard:official-mcps",
    "test": "pnpm -r test",
    "deploy:api": "./scripts/deploy-api.sh"
  },
  "engines": {
    "node": ">=20"
  }
}
